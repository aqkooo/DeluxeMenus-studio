<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejyqyl.dmstudio.controller.PreviewController"
      spacing="6.0">
    <padding>
        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0"/>
    </padding>

    <!-- Toolbar without redundant duplicate title -->
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label fx:id="formatHintLabel" text="YAML 1.2 • UTF-8" styleClass="field-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="copyStatusLabel" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold; -fx-font-size: 11px;"/>
        <Button fx:id="btnCopy" text="%preview.copy" styleClass="button"/>
    </HBox>

    <StackPane fx:id="codeAreaContainer" VBox.vgrow="ALWAYS"
               style="-fx-border-color: -border; -fx-border-radius: 4; -fx-background-color: -bg-slot;"/>

</VBox>
