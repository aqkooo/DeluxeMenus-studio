<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejyqyl.dmstudio.controller.MenuPropertiesController"
      spacing="8.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <Label text="%prop.title" styleClass="section-header"/>

    <VBox spacing="2.0">
        <Label text="%prop.menu_title" styleClass="field-label"/>
        <TextField fx:id="titleField" promptText="%prop.menu_title_prompt"/>
    </VBox>

    <VBox spacing="2.0">
        <Label text="%prop.menu_title.preview" styleClass="field-label"/>
        <StackPane alignment="CENTER_LEFT"
                   style="-fx-background-color: -bg-slot; -fx-border-color: -border; -fx-padding: 6; -fx-background-radius: 4; -fx-border-radius: 4;">
            <TextFlow fx:id="titlePreviewFlow"/>
        </StackPane>
    </VBox>

    <Separator/>

    <GridPane hgap="10.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0"/>
            <ColumnConstraints percentWidth="50.0"/>
        </columnConstraints>
        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="%prop.menu_type" styleClass="field-label"/>
            <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="%prop.size" styleClass="field-label"/>
            <ComboBox fx:id="sizeCombo" maxWidth="Infinity"/>
        </VBox>
    </GridPane>

    <VBox spacing="2.0">
        <Label text="%prop.open_command" styleClass="field-label"/>
        <TextField fx:id="openCommandField" promptText="%prop.open_command_prompt"/>
    </VBox>

    <CheckBox fx:id="registerCommandCheck" text="%prop.register_command"/>

    <VBox spacing="2.0">
        <Label text="%prop.update_interval" styleClass="field-label"/>
        <Spinner fx:id="updateIntervalSpinner" maxWidth="Infinity"/>
    </VBox>

</VBox>
